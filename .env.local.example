# ============================================
# Easy Audio Generator - Environment Variables
# ============================================
# Copy this file to .env.local and fill in your values
# cp .env.local.example .env.local

# --------------------------------------------
# Firebase Admin SDK (Server-side)
# --------------------------------------------
# Get these from Firebase Console > Project Settings > Service Accounts
FIREBASE_ADMIN_PROJECT_ID=your-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour_Private_Key_Here\n-----END PRIVATE KEY-----\n"

# --------------------------------------------
# Firebase Client SDK (Client-side)
# --------------------------------------------
# Get these from Firebase Console > Project Settings > General > Your Apps
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abcdef123456

# --------------------------------------------
# LM Studio / Local LLM
# --------------------------------------------
# URL of your LM Studio server (default: http://localhost:1234/v1)
LM_STUDIO_URL=http://localhost:1234/v1

# Model name as shown in LM Studio (optional, uses default if not set)
LM_STUDIO_MODEL=gemma-4

# --------------------------------------------
# Cloudflare R2 Storage (S3-compatible)
# --------------------------------------------
# Get these from Cloudflare Dashboard > R2 > Manage R2 API Tokens
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=easy-audio-generator
R2_PUBLIC_URL=https://your-r2-public-url.r2.dev

# --------------------------------------------
# Application Settings
# --------------------------------------------
# Base URL for the application (used for share links)
NEXT_PUBLIC_APP_URL=http://localhost:3000
